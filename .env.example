# Copy to .env.local and fill in. Never commit real values.

# TypeSafe API key for Jev. Server only: never expose it to the client.
TYPESAFE_API_KEY=

# Jev model, pinned so results are reproducible during the activity.
# Don't switch to jev-latest without a deliberate decision.
JEV_MODEL=jev-1.13.0

# Neon Postgres connection string (set by the Vercel Marketplace Neon integration).
# Vercel uses ONE value for Development, Preview and Production. In .env.local,
# point it at a Neon dev branch instead: `npm run dev`, the e2e tests,
# db:migrate and db:seed all use it. drizzle.config.ts gives .env.local
# precedence over .env.
DATABASE_URL=

# Not read by the app. Set it only on the command line to point drizzle-kit
# at production on purpose (README → Despliegue); it wins over .env.local:
#   DATABASE_URL_MIGRACION="<production url>" npm run db:migrate

# Evaluators sign in with email + password (PRD §5.12); there are no class
# codes since v1.2. These two codes are for the docente and the admin only.

# Docente access code (grants role "docente", which can view reports and
# switch jornada in the app).
CODIGO_DOCENTE=

# Admin access code (grants role "admin": only /admin, where the participant
# count and names are set). Anyone with it can rename participants, so keep it
# out of the repo and prefer a long, hard-to-guess value in production.
CODIGO_ADMIN=

# HMAC secret for the session cookie: at least 32 random bytes.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Participants shown (unnamed, "Participante NN") until the admin saves the
# real list at /admin. Applies per jornada, until that jornada has rows.
CANTIDAD_PARTICIPANTES=20

# --- Email (v1.2, PRD §13 Email) ---

# Resend API key. Server only. A "Sending access" key from the owner's Resend
# team, added by hand to Vercel (`vercel env add RESEND_API_KEY`); locally it
# arrives in .env. Don't `vercel env pull .env.local`: it would overwrite the
# dev-branch DATABASE_URL in that file.
RESEND_API_KEY=

# Sender address on the domain verified in Resend (SPF, DKIM, DMARC). Without
# a verified domain Resend only delivers to the account owner's own address.
CORREO_REMITENTE="Nivela <no-responder@correo.nivela.snhware.lat>"

# Email transport: "consola" (the default outside production) keeps the last
# 20 messages in memory and shows them at /dev/correos; "resend" sends.
# Production always sends through Resend, whatever this says.
CORREO_MODO=consola

# --- Development and e2e only ---

# Password of the fake evaluator accounts (<integranteId>@ejemplo.test) that
# `npm run cuentas:prueba` and `npm run db:seed` create on the dev branch and
# the e2e tests sign in with. At least 8 characters. Never set it in Vercel.
E2E_CONTRASENA=
