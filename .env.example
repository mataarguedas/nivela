# Copy to .env.local and fill in. Never commit real values.

# TypeSafe API key for Jev. Server only: never expose it to the client.
TYPESAFE_API_KEY=

# Jev model, pinned so results are reproducible during the activity.
# Don't switch to jev-latest without a deliberate decision.
JEV_MODEL=jev-1.13.0

# Neon Postgres connection string (set by the Vercel Marketplace Neon integration).
# Vercel uses ONE value for Development, Preview and Production. In .env.local,
# point it at a Neon dev branch instead: `npm run dev`, the e2e tests,
# db:migrate and db:seed all use it. drizzle.config.ts gives .env.local
# precedence over .env.
DATABASE_URL=

# Class access code (grants role "evaluador").
CODIGO_ACCESO=

# Docente access code (grants role "docente", which can view reports).
CODIGO_DOCENTE=

# HMAC secret for the session cookie: at least 32 random bytes.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Number of anonymous participants (placeholder until confirmed, PRD §16).
CANTIDAD_PARTICIPANTES=20
